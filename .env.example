# URL pública del sitio. En local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# En Vercel, después del primer deploy, reemplazar por la URL final y redeploy:
# NEXT_PUBLIC_SITE_URL=https://visiong.vercel.app

# Web3Forms (https://web3forms.com) — la access key vive solo en el servidor.
WEB3FORMS_ACCESS_KEY=

# Opcional. Si existe, además del email se hace POST del lead a este webhook (n8n, Make, CRM).
LEAD_WEBHOOK_URL=

# Cuando exista un dominio propio se puede cambiar el envío a Resend sin tocar el formulario.
# LEAD_PROVIDER=resend
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# RESEND_FROM_EMAIL=VisionG <hola@tudominio.com>
